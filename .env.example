APP_NAME=Risk Notification Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000

MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=notifications_db

N8N_NOTIFICATION_WEBHOOK_URL=https://example.n8n.cloud/webhook/teams-notification
N8N_ACTION_WEBHOOK_URL=https://example.n8n.cloud/webhook/teams-action

N8N_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000

# Optional internal API key protection for sensitive internal endpoints
# (e.g. POST /api/risk-actions/execute). Disabled by default for local dev.
INTERNAL_API_KEY=
INTERNAL_API_KEY_ENABLED=false
